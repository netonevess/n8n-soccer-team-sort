          "responseData": "<!DOCTYPE html> <html lang=\"pt-BR\"> <head> <meta charset=\"UTF-8\"> <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"> <title>Lista</title>  <style> * {     box-sizing: border-box;     margin: 0;     padding: 0; }  body {     font-family: Arial, sans-serif;     background: #f5f5f5;     padding: 16px; }  .container {     max-width: 600px;     margin: auto; }  .card {     background: white;     padding: 16px;     border-radius: 12px;     box-shadow: 0 2px 8px rgba(0,0,0,.08); }  h1 {     font-size: 1.3rem;     margin-bottom: 16px; }  label {     display: block;     margin-bottom: 8px;     font-weight: bold; }  textarea {     width: 100%;     min-height: 180px;     border: 1px solid #ddd;     border-radius: 8px;     padding: 12px;     font-size: 16px;     resize: vertical; }  .buttons {     display: flex;     gap: 8px;     margin-top: 12px; }  button {     flex: 1;     border: none;     border-radius: 8px;     padding: 14px;     font-size: 16px;     cursor: pointer; }  .btn-paste {     background: #e0e0e0; }  .btn-send {     background: #1976d2;     color: white; }  .btn-copy {     background: #388e3c;     color: white;     margin-top: 12px;     width: 100%; }  .response {     margin-top: 20px; }  pre {     background: #222;     color: #fff;     padding: 12px;     border-radius: 8px;     overflow-x: auto;     white-space: pre-wrap;     word-break: break-word; } </style> </head> <body>  <div class=\"container\">     <div class=\"card\">          <h1>Lista</h1>          <label for=\"lista\">Lista</label>          <textarea id=\"lista\" placeholder=\"Cole aqui sua lista...\"></textarea>          <div class=\"buttons\">             <button class=\"btn-paste\" id=\"pasteBtn\">                 Colar             </button>              <button class=\"btn-send\" id=\"sendBtn\">                 Enviar             </button>         </div>          <div class=\"response\">             <pre id=\"resultado\">A resposta aparecerá aqui...</pre>              <button class=\"btn-copy\" id=\"copyBtn\">                 Copiar Resposta             </button>         </div>      </div> </div>  <script> const lista = document.getElementById(\"lista\"); const resultado = document.getElementById(\"resultado\");  document.getElementById(\"pasteBtn\").addEventListener(\"click\", async () => {     try {         const texto = await navigator.clipboard.readText();         lista.value = texto;     } catch (e) {         alert(\"Não foi possível acessar a área de transferência.\");     } });  document.getElementById(\"sendBtn\").addEventListener(\"click\", async () => {      resultado.textContent = \"Enviando...\";      try {         const response = await fetch(             \"https://alvaro-neves-learn.app.n8n.cloud/webhook/pelada\",             {                 method: \"POST\",                 headers: {                     \"Content-Type\": \"application/json\"                 },                 body: JSON.stringify({                     lista: lista.value                 })             }         );          const text = await response.text();          try {             const json = JSON.parse(text);             resultado.textContent = JSON.stringify(json, null, 2);         } catch {             resultado.textContent = text;         }      } catch (error) {         resultado.textContent =             \"Erro ao enviar: \" + error.message;     } });  document.getElementById(\"copyBtn\").addEventListener(\"click\", async () => {     try {         await navigator.clipboard.writeText(resultado.textContent);         alert(\"Resposta copiada!\");     } catch {         alert(\"Não foi possível copiar.\");     } }); </script>  </body> </html>"
